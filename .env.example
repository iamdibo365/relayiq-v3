# ---------- Models (real APIs, you pay per use) ----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FRONTDESK_MODEL=claude-haiku-4-5
SPECIALIST_MODEL=claude-haiku-4-5
REASONING_MODEL=claude-sonnet-5-5
SIM_CALLER_MODEL=gpt-5.4-mini
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin

# ---------- Twilio (Programmable Voice + Media Streams) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Public HTTPS URL of this app (cloudflared / ngrok tunnel), no trailing slash
PUBLIC_BASE_URL=https://example.trycloudflare.com
# Calls from this number reach Forge (the agent builder) instead of the front desk
ADMIN_PHONE=+1XXXXXXXXXX
# Where "transfer me to a person" goes
HUMAN_TRANSFER_PHONE=+1XXXXXXXXXX

# ---------- Clinic ----------
CLINIC_NAME=Lakeside Family Medicine
CLINIC_NPI=
CLINIC_TIMEZONE=America/Chicago
# Where the texted "pay your balance" link points (your real patient billing portal)
BILLING_PORTAL_URL=

# ---------- Insurance verification ----------
# 1) Clearinghouse API (X12 270/271 as JSON). Test keys hit Stedi's test environment.
STEDI_API_KEY=
STEDI_ELIGIBILITY_URL=https://healthcare.us.stedi.com/2026-06-01/eligibility-check
# 2) Payer-portal browser agent (fallback). Off until you have a provider-portal login
#    AND have confirmed the portal's terms allow automated access for your account.
PORTAL_AUTOMATION_ENABLED=false
PORTAL_HEADLESS=true
PORTAL_CIGNA_URL=https://cignaforhcp.cigna.com/
PORTAL_CIGNA_USERNAME=
PORTAL_CIGNA_PASSWORD=
PORTAL_CIGNA_TOTP_SECRET=
PORTAL_UHC_URL=https://www.uhcprovider.com/
PORTAL_UHC_USERNAME=
PORTAL_UHC_PASSWORD=
PORTAL_UHC_TOTP_SECRET=

# ---------- Platform ----------
DB_PATH=data/relayiq.db
MCP_URL=http://127.0.0.1:8765/mcp
LATENCY_SLO_MS=1500

# --- Latency options ---
# Start Claude on the streaming (partial) transcript; audio and any write wait for the final transcript.
SPECULATIVE_TURNS=true
# chained = Twilio -> OpenAI STT -> Claude -> OpenAI TTS (default)
# s2s     = Twilio -> OpenAI realtime voice (gpt-realtime) -> clinic_agent tool -> Claude agents
VOICE_MODE=chained
REALTIME_MODEL=gpt-realtime
